{
  "name": "@iapstack/host",
  "version": "0.1.0-sdk.1",
  "description": "Trusted-host TypeScript client for the IAPStack v1 API.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "homepage": "https://github.com/imariman/iapstack",
  "keywords": [
    "iapstack",
    "entitlements",
    "webhooks",
    "customer-sessions",
    "in-app-purchases"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imariman/iapstack.git",
    "directory": "sdk/typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.5.2",
    "typescript": "5.9.2"
  },
  "author": "IAPStack Contributors"
}
