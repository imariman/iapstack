# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/
.gradle/
sdk/android/**/build/
sdk/ios/.build/
.build/
.swiftpm/
sdk/ios/example/**/.build/
sdk/ios/example/**/.swiftpm/
sdk/android/build/
sdk/react-native/dist/
sdk/react-native/native/
sdk/react-native/**/*.tgz
sdk/typescript/*.tgz
sdk/typescript/dist/

# Go workspace file
go.work
go.work.sum

# env file
.env
scripts/apple-sandbox.env
scripts/huawei-sandbox.env

# Editor/IDE
.DS_Store
# .idea/
# .vscode/

# Local research and generated scratch files
/tmp/

# Native Android store configuration and credentials
sdk/android/local.properties
sdk/android/example/store.properties
sdk/android/**/agconnect-services.json
sdk/android/**/*.keystore
sdk/android/**/*.jks
sdk/android/example/trusted-host/*.env
sdk/android/**/__pycache__/
scripts/__pycache__/
scripts/tests/__pycache__/
sdk/flutter/**/coverage/
