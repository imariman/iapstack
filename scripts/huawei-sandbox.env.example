# Copy this file to scripts/huawei-sandbox.env. It contains identifiers only;
# the IAPStack application key and signing passwords belong in macOS Keychain.
IAPSTACK_BASE_URL=https://iap.example.com
IAPSTACK_APPLICATION_ID=huawei-sandbox
IAPSTACK_EXTERNAL_CUSTOMER_ID=018f59d0-a200-7000-8000-000000000001
IAPSTACK_HUAWEI_PACKAGE_NAME=com.iapstack.example.iapstack_huawei_example
IAPSTACK_HUAWEI_SUBSCRIPTION_ID=premium_monthly
IAPSTACK_HUAWEI_NON_CONSUMABLE_ID=premium_lifetime
IAPSTACK_HUAWEI_BUILD_NAME=0.1.0
IAPSTACK_HUAWEI_BUILD_NUMBER=1

# Leave empty to let the runner select the first connected physical Android device.
# HMS Toolkit/remote ADB devices are supported when Flutter lists them as physical Android devices.
IAPSTACK_ANDROID_DEVICE_ID=

# The service name is non-secret and may be changed when multiple sandboxes share a Mac.
IAPSTACK_HUAWEI_KEYCHAIN_SERVICE=com.imariman.iapstack.huawei-sandbox
