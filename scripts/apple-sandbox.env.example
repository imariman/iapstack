# Copy this file to scripts/apple-sandbox.env. It contains identifiers only;
# durable IAPStack and App Store private keys belong in macOS Keychain.
IAPSTACK_BASE_URL=https://iap.example.com
IAPSTACK_APPLICATION_ID=ios-sandbox
IAPSTACK_EXTERNAL_CUSTOMER_ID=018f59d0-a200-7000-8000-000000000001
IAPSTACK_APPLE_SUBSCRIPTION_ID=premium_monthly
IAPSTACK_APPLE_NON_CONSUMABLE_ID=premium_lifetime

# Leave empty to let the runner select the first connected physical iOS device.
IAPSTACK_IOS_DEVICE_ID=

# App Store Server API identity used by the notification test helper.
IAPSTACK_APPLE_ISSUER_ID=99b16628-15e4-4668-972b-eeff55eeff55
IAPSTACK_APPLE_KEY_ID=ABCDEFGHIJ
IAPSTACK_APPLE_BUNDLE_ID=com.example.application

# The service name is non-secret and may be changed when multiple sandboxes share a Mac.
IAPSTACK_APPLE_KEYCHAIN_SERVICE=com.imariman.iapstack.apple-sandbox
