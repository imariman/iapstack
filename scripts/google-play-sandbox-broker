#!/usr/bin/env python3
"""Mint short-lived IAPStack customer sessions for an Android emulator.

The durable application bearer stays in macOS Keychain. The server binds only
to host loopback; Android Emulator reaches it through the 10.0.2.2 alias.
"""

from __future__ import annotations

import json
import os
import ssl
import subprocess
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


HOST = "127.0.0.1"
PORT = int(os.environ.get("IAPSTACK_BROKER_PORT", "18767"))
BASE_URL = os.environ.get(
    "IAPSTACK_BASE_URL", "https://iapstack-sandbox.onrender.com"
).rstrip("/")
APPLICATION_ID = os.environ.get("IAPSTACK_APPLICATION_ID", "android-sandbox")
EXTERNAL_CUSTOMER_ID = os.environ.get(
    "IAPSTACK_EXTERNAL_CUSTOMER_ID", "google-play-sandbox-tester-metehan"
)
KEYCHAIN_SERVICE = "com.imariman.iapstack.google-play-test"
KEYCHAIN_ACCOUNT = "android-sandbox:application-bearer"
TLS_CERTIFICATE = os.environ.get(
    "IAPSTACK_BROKER_TLS_CERTIFICATE",
    os.path.expanduser("~/.config/iapstack/google-play-test/broker-cert.pem"),
)
TLS_PRIVATE_KEY = os.environ.get(
    "IAPSTACK_BROKER_TLS_PRIVATE_KEY",
    os.path.expanduser("~/.config/iapstack/google-play-test/broker-key.pem"),
)


def application_bearer() -> str:
    result = subprocess.run(
        [
            "security",
            "find-generic-password",
            "-w",
            "-s",
            KEYCHAIN_SERVICE,
            "-a",
            KEYCHAIN_ACCOUNT,
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    bearer = result.stdout.strip()
    if not bearer:
        raise RuntimeError("application bearer is missing")
    return bearer


class SessionHandler(BaseHTTPRequestHandler):
    server_version = "IAPStackSandboxBroker/1"

    def do_GET(self) -> None:
        if self.path != "/health":
            self.send_error(404)
            return
        self.send_json(200, {"status": "ready"})

    def do_POST(self) -> None:
        if self.path != "/session":
            self.send_error(404)
            return
        print("customer session request received", flush=True)
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length <= 0 or length > 4096:
                raise ValueError("invalid request size")
            request_body = json.loads(self.rfile.read(length))
            if request_body != {
                "application_id": APPLICATION_ID,
                "external_customer_id": EXTERNAL_CUSTOMER_ID,
            }:
                raise ValueError("unexpected application or customer")
            payload = json.dumps(
                {"external_customer_id": EXTERNAL_CUSTOMER_ID}
            ).encode("utf-8")
            application = urllib.parse.quote(APPLICATION_ID, safe="")
            request = urllib.request.Request(
                f"{BASE_URL}/v1/applications/{application}/customer-sessions",
                data=payload,
                headers={
                    "Authorization": f"Bearer {application_bearer()}",
                    "Content-Type": "application/json",
                },
                method="POST",
            )
            with urllib.request.urlopen(request, timeout=15) as response:
                session = json.load(response)
            token = session.get("token")
            if not isinstance(token, str) or not token:
                raise ValueError("invalid upstream response")
            self.send_json(
                200,
                {"token": token, "expires_at": session.get("expires_at")},
            )
            print("customer session request completed", flush=True)
        except (ValueError, RuntimeError, subprocess.SubprocessError):
            print("customer session request rejected", flush=True)
            self.send_json(400, {"error": "session request rejected"})
        except (urllib.error.URLError, TimeoutError):
            print("customer session service unavailable", flush=True)
            self.send_json(502, {"error": "session service unavailable"})

    def send_json(self, status: int, value: object) -> None:
        body = json.dumps(value).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


if __name__ == "__main__":
    server = ThreadingHTTPServer((HOST, PORT), SessionHandler)
    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    tls.minimum_version = ssl.TLSVersion.TLSv1_2
    tls.load_cert_chain(TLS_CERTIFICATE, TLS_PRIVATE_KEY)
    server.socket = tls.wrap_socket(server.socket, server_side=True)
    print(f"IAPStack Android sandbox broker ready on https://{HOST}:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
